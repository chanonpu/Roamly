# Leave unset to call the API at the same origin (fetch('/api/...')).
# Set this if the backend runs on a different host/port during local dev,
# e.g. frontend on :5173 (Vite) and the Roamly API on :4000.
VITE_API_URL=http://localhost:4000

# Required — same Supabase project as the backend. This is the PUBLIC anon
# key (safe to ship to the browser — Supabase Auth uses it to issue
# sessions, and RLS in supabase/schema.sql governs what it can actually
# read/write). Project Settings > API in the Supabase dashboard.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
