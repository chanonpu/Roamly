# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Required — Supabase project (Project Settings > API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is secret: server-only, never send it to a browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional — if unset, the AI routes fall back to fast heuristic generators
# so the app is fully functional with zero external dependencies.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Only used by the optional local-only fallback store (src/db/store.local.ts) ---
# Not used by default — the app talks to Supabase. See README "Running
# without Supabase" if you want the old zero-setup file-backed mode instead.
DB_FILE=./src/data/db.json
